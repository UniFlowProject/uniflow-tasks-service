# Authentication is delegated to AWS API Gateway with Amazon Cognito. This
# service neither issues nor validates tokens. It trusts these headers, which
# the gateway must set from the verified Cognito claims on every request:
#   X-User-Id (required), X-User-Email, X-User-Name, X-User-Picture (optional)
# The service must only be reachable through the gateway, otherwise clients
# could send these headers themselves.

# Persistence: memory | dynamodb
TASKS_REPOSITORY=memory
TASKS_TABLE_NAME=uniflow-tasks

# AWS (used by DynamoDB and EventBridge Scheduler)
AWS_REGION=us-east-1
# Local development only (leave unset in production, an empty value is not None)
# DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000

# Due-date reminders: noop | eventbridge
# With eventbridge, REMINDER_QUEUE_ARN and REMINDER_ROLE_ARN are required and
# the service refuses to start without them.
REMINDER_SCHEDULER=noop
REMINDER_GROUP_NAME=default
REMINDER_LEAD_TIME_HOURS=24
# SQS queue that receives the reminder
REMINDER_QUEUE_ARN=
# IAM role EventBridge Scheduler assumes to send to the queue
REMINDER_ROLE_ARN=
